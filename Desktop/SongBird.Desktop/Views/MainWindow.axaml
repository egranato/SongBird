<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SongBird.Desktop.ViewModels"
        xmlns:views="using:SongBird.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SongBird.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SongBird.Desktop">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!--
        PlayerBarView is outside the page ContentControl so playback survives page navigation.
        Docked Top, not Bottom - see Desktop/CLAUDE.md's DockPanel.Dock="Bottom" gotcha.
    -->
    <DockPanel>
        <views:PlayerBarView DockPanel.Dock="Top" DataContext="{Binding Player}" />
        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>

</Window>
